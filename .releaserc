{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash scripts/prepare-swiftpm-release.sh ${nextRelease.gitTag} && MOTIONSWIFT_SMOKE_LOCAL_NATIVE=1 bash scripts/verify-swiftpm-release.sh"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["Package.swift", "Sources/MotionCompiler/Resources/**", "Sources/MotionPortable/JavaScript/**"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "releasedLabels": false,
        "assets": [
          {"path": ".build/swiftpm-release/*.xcframework.zip"},
          {"path": ".build/swiftpm-release/*.xcframework.zip.sha256"}
        ]
      }
    ]
  ]
}
